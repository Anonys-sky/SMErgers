# Copy to .env (local) or add to Replit Secrets. Never commit the real .env.

# Signs the session cookie that remembers which role you are viewing as.
# Optional: if unset, a random key is made at start-up (you are reset to Project manager on restart).
SECRET_KEY=change-me

# WhatsApp Live Bridge (optional)
# WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
# WHATSAPP_TIMEZONE=Asia/Kuala_Lumpur


# Official WhatsApp Cloud API webhook (optional in the prototype)
# WHATSAPP_VERIFY_TOKEN=a-token-you-choose       # echoed back during Meta's webhook verification
# WHATSAPP_APP_SECRET=your-meta-app-secret       # when set, every webhook must carry a valid signature
