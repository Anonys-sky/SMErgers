{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "python scripts/build-vercel.py",
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "includeFiles": "{data/**,src/**}",
      "excludeFiles": "{.venv/**,venv/**,node_modules/**,tests/**,docs/**,submission/**,output/**,tmp/**,whatsapp/**,.wwebjs_auth/**,.wwebjs_cache/**}"
    }
  }
}
