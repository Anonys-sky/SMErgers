{
  "name": "smergers-whatsapp-bridge",
  "private": true,
  "description": "Reads WhatsApp group messages for SMErgers through whatsapp-web.js (see whatsapp/bridge.js)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "bash scripts/start-application.sh",
    "check:browser": "node whatsapp/browser.js",
    "whatsapp": "node whatsapp/bridge.js",
    "test": "node --test whatsapp/*.test.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7"
  },
  "overrides": {
    "whatsapp-web.js": {
      "puppeteer": "25.16.0"
    }
  },
  "allowScripts": {
    "whatsapp-web.js@1.34.7": true,
    "puppeteer@25.16.0": true
  }
}
