run = "python src/main.py"
entrypoint = "src/main.py"
modules = ["python-3.12", "web", "nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["chromium"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-application.sh"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
run = ["bash", "scripts/start-application.sh"]
deploymentTarget = "vm"
ignorePorts = false
build = ["bash", "scripts/build-production.sh"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
